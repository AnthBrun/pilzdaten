+	if err != nil {
+		return fmt.Errorf("Filterdefinition %q öffnen: %w", path, err)
+	}
+	defer file.Close()
+	if err := json.NewDecoder(file).Decode(facets); err != nil {
+		return fmt.Errorf("Filterdefinition %q lesen: %w", path, err)
+	}
+	return nil
+}

# Kopieren nach .env und anpassen.

# Ordner mit den Artfotos (enthält daten/details/<Slug>-Dateien/…).
IMAGE_DIR=../pilzsuche/raw/images

# Host-Port der App (nur Docker Compose).
APP_PORT=8080

# DeepL-Schlüssel, nur für go run ./cmd/translate (siehe README, "Übersetzungen").
# Free-Schlüssel enden auf :fx. Nie committen.
DEEPL_API_KEY=

# Tokens der nativen App (pilzkorb) für das Daten-Bundle unter /app/bundle/,
# kommagetrennt (zum Wechseln alten und neuen Token eine Zeit lang parallel).
# Leer = Route aus. Erzeugen z. B. mit: openssl rand -hex 24. Nie committen.
APP_TOKENS=

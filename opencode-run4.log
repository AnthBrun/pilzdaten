+.synonyms > span:first-child { margin-right: 3px; }
+.synonym { padding: 6px 10px; border: 1px solid var(--line); border-radius: 99px; background: #fbfbf8; color: #59675d; }
+.detail-hero-photo { min-width: 0; margin: 0; overflow: hidden; border-radius: 8px; background: #e9e9e0; }
+.detail-hero-photo .image-open { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
+.detail-hero-photo img { display: block; width: 100%; max-height: 360px; aspect-ratio: 1.15; object-fit: contain; }
+.edibility-banner { display: flex; flex-wrap: wrap; align-items: center; gap: 9px 14px; margin-top: 18px; padding: 14px 17px; border-radius: 6px; }
+.edibility-banner .edibility-badge { margin: 0; font-size: 12px; padding: 7px 10px; }
+.edibility-banner p { margin: 0; color: #59645c; font-size: 12px; }
+.edibility-banner.edibility-poisonous, .edibility-banner.edibility-deadly { border: 1px solid #e4b49b; }
+.safety-warning { width: 100%; font-weight: 700; }
+.detail-section { padding: 37px 0 12px; }
+.detail-section-heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 17px; }
+.detail-section-heading .eyebrow { margin-bottom: 7px; }
+.detail-section-heading h2 { font: 600 28px "Playfair Display", Georgia, serif; letter-spacing: -.03em; margin: 0; }
+.heading-count { font: 400 15px "DM Sans", sans-serif; color: #9aa39b; }
+.traits-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; margin: 0; }
+.trait-card { background: var(--white); border: 1px solid #e8e9e2; border-radius: 5px; padding: 15px 17px; min-width: 0; }
+.trait-card dt { font-size: 10px; text-transform: uppercase; letter-spacing: .1em; font-weight: 700; color: #66806b; margin-bottom: 8px; }
+.trait-card dd { font-size: 13px; line-height: 1.65; color: #39463d; margin: 0; white-space: pre-line; overflow-wrap: anywhere; }
+.image-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
+.mushroom-image { margin: 0; background: white; border: 1px solid #e8e9e2; border-radius: 5px; overflow: hidden; }
+.image-open { display: flex; justify-content: center; align-items: center; width: 100%; padding: 0; border: 0; background: #f4f4ee; cursor: zoom-in; }
+.image-open img { display: block; width: auto; max-width: 100%; height: auto; max-height: 560px; object-fit: contain; background: #f4f4ee; }
+.mushroom-image img { max-height: 260px; }
+.mushroom-image figcaption { padding: 9px 12px; color: #758077; font-size: 10px; background: #f4f4ee; }
+.source-link { border-top: 1px solid var(--line); margin-top: 36px; padding-top: 19px; color: #79837b; font-size: 11px; }
+.source-link a { color: var(--green); }
+.source-link a:hover { text-decoration: underline; }
+.lightbox { position: fixed; inset: 0; z-index: 20; display: none; align-items: center; justify-content: center; padding: 4vh 5vw; background: rgb(12 17 14 / .94); color: white; }
+.lightbox.is-open { display: flex; }
+.lightbox-image { display: block; max-width: 95vw; max-height: 92vh; object-fit: contain; }
+.lightbox button { position: absolute; z-index: 1; border: 0; background: rgb(255 255 255 / .13); color: white; border-radius: 50%; width: 44px; height: 44px; font-size: 28px; line-height: 1; cursor: pointer; }
+.lightbox button:hover { background: rgb(255 255 255 / .25); }
+.lightbox-close { top: 18px; right: 20px; }
+.lightbox-prev { left: 18px; top: 50%; transform: translateY(-50%); }
+.lightbox-next { right: 18px; top: 50%; transform: translateY(-50%); }
+.lightbox-count { position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; font-size: 12px; color: #e1e5df; }
+.lightbox-active { overflow: hidden; }
+.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+@media (max-width: 950px) {
+  .species-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .filter-layout { grid-template-columns: minmax(290px, 340px) minmax(0, 1fr); gap: 16px; }
+  .alphabet { grid-template-columns: repeat(13, minmax(0, 1fr)); }
+}
+@media (max-width: 768px) {
+  main { padding: 0 20px; }
+  .topbar { padding: 0 20px; }
+  .hero { padding: 23px 0 19px; grid-template-columns: minmax(0, 1fr); gap: 9px; }
+  .hero .eyebrow { grid-column: 1; }
+  .hero h1 { font-size: 38px; }
+  .hero-copy { grid-column: 1; grid-row: auto; }
+  .search-box { grid-column: 1; grid-row: auto; width: 100%; height: 44px; margin-top: 3px; }
+  .catalog-section { padding-top: 18px; }
+  .section-heading { align-items: start; gap: 10px; }
+  .section-heading h2 { font-size: 24px; }
+  .section-intro { max-width: 275px; line-height: 1.4; }
+  .count-pill { padding: 7px 9px; font-size: 9px; }
+  .filter-layout { grid-template-columns: minmax(0, 1fr); gap: 11px; }
+  .mushroom-lab { position: relative; top: auto; max-height: none; overflow: visible; padding: 13px; }
+  .mushroom-stage { height: min(94vw, 370px); max-height: 370px; }
+  .mushroom-svg { height: 100%; max-width: 340px; }
+  .swatch-popover { position: fixed; top: auto; right: 0; bottom: 0; left: 0; width: 100%; max-height: 70vh; padding: 17px max(16px, env(safe-area-inset-left)) calc(18px + env(safe-area-inset-bottom)); border-radius: 16px 16px 0 0; box-shadow: 0 -12px 40px #24372c30; }
+  .option-list.color-options { grid-template-columns: repeat(5, minmax(0, 1fr)); }
+  .popover-choice { min-height: 38px; font-size: 10px; }
+  .results-toolbar { position: sticky; top: 0; z-index: 4; margin-bottom: 9px; padding: 9px 10px; }
+  .results-heading-row strong { font-size: 13px; }
+  .species-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
+  .card-copy { padding: 8px; }
+  .card-copy strong { font-size: 11px; }
+  .edibility-badge { font-size: 8px; padding: 4px 5px; }
+  .alphabet { grid-template-columns: repeat(7, minmax(0, 1fr)); }
+  footer { padding: 20px; }
+  .detail-page { padding-bottom: 50px; }
+  .detail-hero { grid-template-columns: 1fr; gap: 17px; padding: 21px 0 27px; }
+  .detail-hero-photo { grid-row: 1; }
+  .detail-hero-photo img { max-height: 340px; }
+  .detail-hero h1 { font-size: 42px; }
+  .detail-section { padding-top: 31px; }
+  .detail-section-heading h2 { font-size: 25px; }
+  .traits-grid { grid-template-columns: 1fr; }
+  .trait-card { padding: 14px; }
+  .image-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
+  .image-open img { max-height: 460px; }
+  .lightbox { padding: 5vh 3vw; }
+  .lightbox button { width: 38px; height: 38px; }
+  .lightbox-prev { left: 8px; }
+  .lightbox-next { right: 8px; }
+}
+@media (max-width: 390px) {
+  main { padding: 0 14px; }
+  .topbar { padding: 0 14px; }
+  .topbar-note { font-size: 9px; }
+  .section-heading { flex-direction: column; align-items: start; }
+  .mushroom-stage { height: 310px; }
+  .mushroom-svg { height: 310px; }
+  .lab-heading h3 { font-size: 18px; }
+  .trait-chip { padding: 4px 6px; font-size: 7.5px; }
+  .card-copy em { font-size: 8px; }
+  footer { padding: 18px 14px; gap: 10px; }
+}
